comercios_conocidos.json
known_merchants.json

# your own fund names and places (private_data.example.json is the public template)
private_data.json

# transactions you marked "not a duplicate"
dismissed_duplicates.json

# what each fund is worth, and how you classified it
fund_values.json
investment_classification.json

# months left out of the averages
excluded_months.json

# ── Secrets — never commit ───────────────────────────────────────────────────
gocardless_secrets.json
bank_links.json
.env
.streamlit/secrets.toml
